{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start infra only",
      "type": "shell",
      // Starts all infra services (postgres, redis, localstack, mailpit) via
      // docker-compose.dev.yml — apps run locally via nx serve.
      "command": "docker compose -f docker-compose.dev.yml up -d",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Started|Running"
        }
      }
    },
    {
      "label": "Docker: Run migrations",
      "type": "shell",
      "command": "npx prisma migrate dev && npx prisma migrate dev --config prisma.config.legal.ts",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}