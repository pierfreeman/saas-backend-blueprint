{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@libs/prisma": ["libs/prisma/src/index.ts"],
      "@libs/prisma/*": ["libs/prisma/src/*"],
      "@libs/redis": ["libs/redis/src/index.ts"],
      "@libs/redis/*": ["libs/redis/src/*"],
      "@libs/common": ["libs/common/src/index.ts"],
      "@libs/common/*": ["libs/common/src/*"],
      "@libs/config": ["libs/config/src/index.ts"],
      "@libs/config/*": ["libs/config/src/*"]
    }
  },
  "include": ["apps/**/*", "libs/**/*"],
  "exclude": ["node_modules", "tmp"]
}
