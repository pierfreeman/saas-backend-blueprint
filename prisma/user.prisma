// ============================================================================
// USER MODEL
// Represents an identity synced from the Auth0 identity provider.
// Users are created on first login via the /auth/me endpoint (upsert).
// ============================================================================

model User {
  /// Internal UUID – used as the primary key across all relations.
  id         String   @id @default(uuid()) @db.Uuid
  /// Auth0 subject identifier ("sub" JWT claim). Immutable after creation.
  auth0Id    String   @unique @map("auth0_id")
  /// Email address sourced from the Auth0 token. Re-synced on every login.
  email      String   @unique
  /// Given name (first name). Synced from Auth0 on first social login; editable by the user.
  firstName  String?  @map("first_name")
  /// Family name (last name). Synced from Auth0 on first social login; editable by the user.
  lastName   String?  @map("last_name")
  /// Profile picture URL. Synced from Auth0 on first social login; editable by the user.
  pictureUrl    String?  @map("picture_url")
  /// Timestamp of first login (record creation).
  createdAt     DateTime @default(now()) @map("created_at")
  /// Timestamp of the last profile sync.
  updatedAt  DateTime @updatedAt @map("updated_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  memberships   Membership[]
  notifications Notification[]

  // ── Indexes ────────────────────────────────────────────────────────────────
  // @unique on auth0Id and email already produce implicit B-tree indexes.
  /// Supports paginated admin listings ordered by sign-up date.
  @@index([createdAt(sort: Desc)])
  @@map("users")
  @@schema("public")
}
