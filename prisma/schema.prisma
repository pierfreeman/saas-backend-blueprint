// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

// ============================================================================
// USER MODEL
// ============================================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  auth0Id   String   @unique @map("auth0_id")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships Membership[]

  @@map("users")
}

// ============================================================================
// ORGANIZATION MODEL
// ============================================================================

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  status           OrganizationStatus @default(ACTIVE)
  stripeCustomerId String?            @unique @map("stripe_customer_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  // Relations
  memberships Membership[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

// ============================================================================
// MEMBERSHIP MODEL (User ↔ Organization relationship)
// ============================================================================

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@index([status])
  @@map("memberships")
}

// ============================================================================
// AUDIT EVENT MODEL
// Provides an immutable, append-only audit trail.
// Satisfies ISO 27001:2022 A.8.15/A.8.16 and GDPR Art. 5(2)/Art. 30/Art. 32.
// ============================================================================

model AuditEvent {
  id            String        @id @default(uuid()) @db.Uuid
  /// Typed event name (e.g. 'org.created', 'auth.login.failed').
  type          String
  /// ISO/GDPR-aligned severity level.
  severity      AuditSeverity @default(INFO)
  /// Nullable – null means a global/system-initiated event.
  orgId         String?       @map("org_id") @db.Uuid
  /// Nullable – null means the action was performed by the system.
  userId        String?       @map("user_id") @db.Uuid
  /// Sanitised structured context for the event (no PII/secrets in plain text).
  payload       Json          @default("{}")
  /// Source IP address for GDPR access-log and security anomaly detection.
  ipAddress     String?       @map("ip_address")
  /// User-Agent header for security context.
  userAgent     String?       @map("user_agent")
  /// Distributed tracing correlation ID.
  correlationId String?       @map("correlation_id")
  /// Records are never updated – use createdAt as the immutable timestamp.
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations (optional – org may be deleted but audit records should remain)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  // Indexes optimised for compliance queries
  @@index([orgId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_events")
}
