// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "app_audit"]
}

// ============================================================================
// ENUMS
// ============================================================================

/// Lifecycle status of an asynchronous background job.
/// Transitions: PENDING → PROCESSING → DONE | FAILED
enum JobStatus {
  /// Job has been accepted and enqueued, waiting for a worker to pick it up.
  PENDING
  /// A worker has dequeued the job and is actively executing it.
  PROCESSING
  /// The worker completed execution successfully. Result is stored in `result`.
  DONE
  /// The worker encountered an unrecoverable error. Details are in `error`.
  FAILED

  @@schema("public")
}

/// Status of an organization data export.
/// Transitions: PENDING → PROCESSING → COMPLETED | FAILED | EXPIRED
enum ExportStatus {
  /// Export has been requested and is waiting to be processed.
  PENDING
  /// Worker is actively generating the export file.
  PROCESSING
  /// Export file has been generated and is ready for download.
  COMPLETED
  /// Export generation failed due to an error.
  FAILED
  /// Export file has expired and is no longer available for download.
  EXPIRED

  @@schema("public")
}

/// Billing lifecycle status of an Organization's subscription.
/// Mirrors Stripe subscription statuses with a NONE sentinel for no subscription.
enum BillingStatus {
  /// No subscription exists (free tier or never subscribed).
  NONE
  /// Currently in a free trial period.
  TRIALING
  /// Active, paid subscription.
  ACTIVE
  /// Payment failed; subscription will be canceled if not resolved.
  PAST_DUE
  /// Subscription was explicitly canceled (may still be active until period end).
  CANCELED
  /// Invoice is open and past due with final payment attempt failed.
  UNPAID
  /// First payment not yet made; subscription is being set up.
  INCOMPLETE
  /// Incomplete subscription expired without payment.
  INCOMPLETE_EXPIRED
  /// Subscription is paused (Stripe feature).
  PAUSED

  @@schema("public")
}

/// Lifecycle status of an Organization.
enum OrganizationStatus {
  /// Organization is fully operational and can be accessed by all its members.
  ACTIVE
  /// Organization has been administratively suspended (e.g. billing failure,
  /// policy violation). Members cannot access org resources while suspended.
  SUSPENDED
  /// Organization deletion has been requested and scheduled; awaiting background worker execution.
  PENDING_DELETION
  /// Organization has been fully deleted; all tenant data removed. Legal audit records remain.
  DELETED

  @@schema("public")
}

/// RBAC role assigned to a Membership. Roles are hierarchical:
/// OWNER > ADMIN > MEMBER > READ_ONLY.
enum MembershipRole {
  /// Full control over the organization, including deletion and owner transfer.
  /// There must always be at least one OWNER per organization.
  OWNER
  /// Can manage members (invite, update role, remove) and read activity logs.
  /// Cannot delete the organization or transfer ownership.
  ADMIN
  /// Standard access to organization resources. Cannot manage other members.
  MEMBER
  /// Read-only access. Cannot create, update, or delete any resource.
  READ_ONLY

  @@schema("public")
}

/// Lifecycle status of a Membership record.
enum MembershipStatus {
  /// Membership is active – the user has full access according to their role.
  ACTIVE
  /// User has been invited but has not yet accepted the invitation.
  INVITED
  /// Membership has been suspended; the user cannot access the organization.
  SUSPENDED

  @@schema("public")
}

// ============================================================================
// USER MODEL
// Represents an identity synced from the Auth0 identity provider.
// Users are created on first login via the /auth/me endpoint (upsert).
// ============================================================================

model User {
  /// Internal UUID – used as the primary key across all relations.
  id        String   @id @default(uuid()) @db.Uuid
  /// Auth0 subject identifier ("sub" JWT claim). Immutable after creation.
  auth0Id   String   @unique @map("auth0_id")
  /// Email address sourced from the Auth0 token. Re-synced on every login.
  email     String   @unique
  /// Timestamp of first login (record creation).
  createdAt DateTime @default(now()) @map("created_at")
  /// Timestamp of the last profile sync.
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  memberships   Membership[]
  notifications Notification[]

  // ── Indexes ────────────────────────────────────────────────────────────────
  // @unique on auth0Id and email already produce implicit B-tree indexes.
  /// Supports paginated admin listings ordered by sign-up date.
  @@index([createdAt(sort: Desc)])
  @@map("users")
  @@schema("public")
}

// ============================================================================
// ORGANIZATION MODEL
// A tenant boundary. All multi-tenant resources are scoped to an Organization.
// ============================================================================

model Organization {
  /// Internal UUID – used as the primary key across all relations.
  id               String             @id @default(uuid()) @db.Uuid
  /// Display name of the organization. Must be at least 3 characters.
  name             String
  /// Current lifecycle status. Defaults to ACTIVE on creation.
  status           OrganizationStatus @default(ACTIVE)
  /// Stripe customer ID, set when the organization subscribes to a paid plan.
  /// Null for free-tier organizations.
  stripeCustomerId          String?        @unique @map("stripe_customer_id")
  /// Stripe subscription ID. Null until a subscription is created.
  subscriptionId            String?        @unique @map("subscription_id")
  /// Current billing lifecycle status. Mirrors Stripe subscription status.
  billingStatus             BillingStatus  @default(NONE) @map("billing_status")
  /// Stripe Price ID of the active plan (e.g. price_xxx). Null if no subscription.
  planId                    String?        @map("plan_id")
  /// Number of billable seats in the current subscription.
  seatCount                 Int            @default(1) @map("seat_count")
  /// Storage quota in bytes. Null means plan default applies.
  storageLimit              BigInt?        @map("storage_limit")
  /// Start of the current billing period (from Stripe).
  subscriptionPeriodStart   DateTime?      @map("subscription_period_start")
  /// End of the current billing period (from Stripe).
  subscriptionPeriodEnd     DateTime?      @map("subscription_period_end")
  /// If true, subscription cancels at the end of the current period.
  cancelAtPeriodEnd         Boolean        @default(false) @map("cancel_at_period_end")
  /// Timestamp when organization deletion was requested (user or system trigger).
  deletionRequestedAt       DateTime?      @map("deletion_requested_at")
  /// Timestamp when the deletion job is scheduled to execute (requestedAt + retention period).
  deletionScheduledAt       DateTime?      @map("deletion_scheduled_at")
  /// Timestamp when deletion completed successfully (status = DELETED).
  deletionCompletedAt       DateTime?      @map("deletion_completed_at")
  /// Custom retention period in days for this organization. Overrides default if set.
  /// Used for enterprise agreements or subscription-specific requirements.
  retentionPeriodDays       Int?           @map("retention_period_days")
  /// Timestamp of organization creation.
  createdAt                 DateTime       @default(now()) @map("created_at")
  /// Timestamp of the last update.
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  memberships            Membership[]
  activityLogs           ActivityLog[]
  billingEvents          BillingEvent[]
  subscriptionSnapshots  SubscriptionSnapshot[]
  files                  File[]

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Supports filtering organizations by lifecycle status (e.g. list all SUSPENDED orgs).
  @@index([status])
  /// Supports paginated admin listings filtered by status, ordered by creation date.
  @@index([status, createdAt(sort: Desc)])
  /// Supports organization name search/lookup (prefix queries use this index).
  @@index([name])
  /// Supports paginated admin listings ordered by creation date.
  @@index([createdAt(sort: Desc)])
  /// Supports admin queries filtering organizations by billing status (e.g. list all PAST_DUE orgs).
  @@index([billingStatus])
  /// Supports paginated admin listings filtered by billing status, ordered by creation date.
  @@index([billingStatus, createdAt(sort: Desc)])
  @@map("organizations")
  @@schema("public")
}

// ============================================================================
// MEMBERSHIP MODEL
// Join table between User and Organization, enriched with role and status.
// A user can belong to multiple organizations, each with an independent role.
// ============================================================================

model Membership {
  /// Internal UUID – primary key.
  id        String           @id @default(uuid()) @db.Uuid
  /// FK → User. Cascade-delete removes the membership when the user is deleted.
  userId    String           @map("user_id") @db.Uuid
  /// FK → Organization. Cascade-delete removes all memberships when the org is deleted.
  orgId     String           @map("org_id") @db.Uuid
  /// RBAC role of the member within this organization.
  role      MembershipRole
  /// Lifecycle status of this membership record. Defaults to ACTIVE.
  status    MembershipStatus @default(ACTIVE)
  /// Timestamp when the membership was created (invitation sent or direct add).
  createdAt DateTime         @default(now()) @map("created_at")
  /// Timestamp of the last role or status change.
  updatedAt DateTime         @updatedAt @map("updated_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Enforces that a user can only have one membership per organization.
  @@unique([userId, orgId])
  /// Supports "list all memberships for an org" (also backing the unique constraint lookup).
  @@index([orgId])
  /// Supports "list all orgs a user belongs to".
  @@index([userId])
  /// Supports filtering memberships by status across all orgs (admin dashboards).
  @@index([status])
  /// Supports the most common RBAC query: "fetch all ACTIVE members of an org".
  @@index([orgId, status])
  /// Supports role-based permission checks: "find all ADMINs/OWNERs of an org".
  @@index([orgId, role])
  @@map("memberships")
  @@schema("public")
}

// ============================================================================
// ACTIVITY LOG MODEL
// Business-level, tenant-visible activity log.
// Scoped to an organisation. Cascade-deleted when the organisation is deleted.
// Not suitable for legal/compliance obligations — use the legal audit database.
// ============================================================================

model ActivityLog {
  /// Internal UUID – primary key.
  id         String   @id @default(uuid()) @db.Uuid
  /// FK → Organization. Cascade-delete removes activity logs when the org is deleted.
  orgId      String   @map("org_id") @db.Uuid
  /// Internal UUID of the user who triggered the action. Nullable for system actions.
  actorId    String?  @map("actor_id") @db.Uuid
  /// RBAC role of the actor at the time of the action (e.g. 'OWNER', 'ADMIN').
  actorRole  String?  @map("actor_role")
  /// Dot-notation action string. Use the narrowest prefix possible.
  /// Examples: 'org.created', 'membership.role.changed', 'org.deleted'
  action     String
  /// Category of the entity the action was performed on (e.g. 'Organization').
  entityType String?  @map("entity_type")
  /// UUID of the entity the action was performed on.
  entityId   String?  @map("entity_id") @db.Uuid
  /// Sanitised structured context. Must NOT contain PII or credentials.
  metadata   Json     @default("{}")
  /// Immutable creation timestamp.
  createdAt  DateTime @default(now()) @map("created_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Primary tenant query: events for a given org, newest first.
  @@index([orgId, createdAt(sort: Desc)])
  /// Action-type queries with time ordering (e.g. all 'org.*' events).
  @@index([action, createdAt(sort: Desc)])
  @@map("activity_logs")
  @@schema("app_audit")
}

// ============================================================================
// JOB MODEL
// Tracks the full lifecycle of an asynchronous background job.
// Created by the API as PENDING when the event is enqueued; updated by the
// worker to PROCESSING → DONE | FAILED.  Queryable via GET /tasks/:jobId.
// ============================================================================

model Job {
  /// Internal UUID – primary key. Matches the jobId propagated on SQS.
  id         String    @id @default(uuid()) @db.Uuid
  /// FK → Organization (tenant). Links the job to a billing/RBAC boundary.
  /// Stored as a plain string (no relation) to avoid cascade complexity;
  /// jobs must survive org deletion for billing audit purposes.
  orgId      String    @map("org_id")
  /// Auth0 subject of the user who submitted the job. Null for system-initiated jobs.
  userId     String?   @map("user_id")
  /// Discriminator for the job handler (e.g. 'heavy_job').
  /// Allows future fan-out to multiple worker types without schema changes.
  type       String    @default("heavy_job")
  /// Current lifecycle status. Defaults to PENDING on creation.
  status     JobStatus @default(PENDING)
  /// Original request payload forwarded verbatim from the API to the worker.
  /// Must NOT contain raw secrets; callers are responsible for sanitisation.
  payload    Json      @default("{}")
  /// Structured output produced by the worker on successful completion.
  result     Json?
  /// Human-readable error message when status = FAILED.
  error      String?
  /// Number of times a worker has attempted this job (incremented on PROCESSING).
  /// Useful for detecting jobs that fail repeatedly before hitting the DLQ.
  attempts   Int       @default(0)
  /// Timestamp when the first PROCESSING transition occurred.
  startedAt  DateTime? @map("started_at")
  /// Timestamp when the job reached a terminal state (DONE or FAILED).
  finishedAt DateTime? @map("finished_at")
  /// Timestamp of record creation (= time the job was accepted by the API).
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Timestamp of the last status update.
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Primary tenant query: "list all jobs for tenant X, newest first".
  @@index([orgId, createdAt(sort: Desc)])
  /// Status-filtered tenant query: "show me all FAILED jobs for tenant X".
  @@index([orgId, status])
  /// User activity timeline: "show me all jobs submitted by user Y".
  @@index([userId, createdAt(sort: Desc)])
  /// Admin/ops query: global status sweep (e.g. stuck PROCESSING jobs).
  @@index([status, createdAt(sort: Desc)])
  @@map("jobs")
  @@schema("public")

  // ── Relations ──────────────────────────────────────────────────────────────
  orgExport  OrgExport?
}

// ============================================================================
// ORGANIZATION EXPORT MODEL
// Tracks organization data export requests for GDPR/ISO 27001 compliance.
// Links to Job for async processing; maintains domain-specific state.
// ============================================================================

/// Organization data export record for GDPR Right to Data Portability.
/// Tracks export lifecycle from request to completion/expiration.
model OrgExport {
  /// Internal UUID – primary key.
  id                String       @id @default(uuid()) @db.Uuid
  /// FK → Organization (plain string, no relation, survives org deletion for audit).
  orgId             String       @map("org_id")
  /// FK → Job (unique 1:1 relationship with the async job processing this export).
  jobId             String       @unique @map("job_id") @db.Uuid
  job               Job          @relation(fields: [jobId], references: [id])
  /// Auth0 subject of the user who requested the export.
  requestedByUserId String       @map("requested_by_user_id")
  /// Current status of the export.
  status            ExportStatus @default(PENDING)
  /// Signed URL to download the export file (set when status = COMPLETED).
  fileUrl           String?      @map("file_url")
  /// Size of the export file in bytes (set when status = COMPLETED).
  fileSize          BigInt?      @map("file_size")
  /// Timestamp when the signed download URL expires.
  expiresAt         DateTime?    @map("expires_at")
  /// Timestamp when the export was requested.
  createdAt         DateTime     @default(now()) @map("created_at")
  /// Timestamp when the export completed successfully.
  completedAt       DateTime?    @map("completed_at")
  /// Timestamp when the export failed.
  failedAt          DateTime?    @map("failed_at")
  /// Human-readable error message if status = FAILED.
  error             String?

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Primary tenant query: "list all exports for org X, newest first".
  @@index([orgId, createdAt(sort: Desc)])
  /// Status-filtered tenant query: "show me all COMPLETED exports for org X".
  @@index([orgId, status])
  /// User activity query: "show me all exports requested by user Y".
  @@index([requestedByUserId, createdAt(sort: Desc)])
  /// Admin/ops query: find exports that have expired.
  @@index([status, expiresAt])
  @@map("org_exports")
  @@schema("public")
}

// ============================================================================
// BILLING EVENT MODEL
// Idempotency tracking for processed Stripe webhook events.
// Prevents duplicate processing of retried or replayed webhooks.
// ============================================================================

/// Immutable record of a processed Stripe webhook event.
/// Used to guarantee idempotent webhook processing.
///
/// TODO: Implement a soft-delete / archival strategy for BillingEvent rows to
/// prevent unbounded table growth in production.
/// Suggested approach: add an `archivedAt DateTime?` column and a background
/// job (e.g. a scheduled Lambda or a cron inside worker-a) that moves rows
/// older than a configurable retention window (e.g. 90 days) to either:
///   a) a cold `billing_events_archive` table in the same DB, or
///   b) an S3 bucket (JSONL per day) with a DROP after export.
/// The idempotency unique constraint on `stripeEventId` must be preserved
/// (or mirrored) in whichever archive store is chosen.
model BillingEvent {
  /// Internal UUID – primary key.
  id            String       @id @default(uuid()) @db.Uuid
  /// FK → Organization. Cascade-delete removes billing events when the org is deleted.
  orgId         String?      @map("org_id") @db.Uuid
  /// Stripe event ID (e.g. evt_xxx). Unique constraint prevents duplicate processing.
  stripeEventId String       @unique @map("stripe_event_id")
  /// Timestamp when the event was first successfully processed.
  processedAt   DateTime     @map("processed_at")
  /// SHA-256 hash of the raw webhook payload for tamper detection.
  payloadHash   String       @map("payload_hash")

  // ── Relations ──────────────────────────────────────────────────────────────
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Idempotency lookup by Stripe event ID (backed by unique constraint).
  @@index([stripeEventId])
  /// Admin/ops audit: list processed events by time.
  @@index([processedAt(sort: Desc)])
  @@map("billing_events")
  @@schema("public")
}

// ============================================================================
// SUBSCRIPTION SNAPSHOT MODEL
// Append-only historical record of subscription state changes.
// Written once per processed Stripe subscription lifecycle event.
// Never updated — Organization remains the source of truth for current state.
// Used only for internal analytics, debugging, support, and billing investigations.
// ============================================================================

/// Immutable point-in-time snapshot of a subscription state.
/// Created for customer.subscription.created/updated/deleted Stripe events.
model SubscriptionSnapshot {
  /// Internal UUID – primary key.
  id                   String       @id @default(uuid()) @db.Uuid
  /// FK → Organization.
  orgId                String       @map("org_id") @db.Uuid
  /// Stripe subscription ID (e.g. sub_xxx).
  stripeSubscriptionId String       @map("stripe_subscription_id")
  /// Stripe Price ID of the plan at the time of the snapshot.
  planId               String?      @map("plan_id")
  /// Stripe subscription status string at the time of the snapshot.
  status               String
  /// Number of billable seats recorded at snapshot time.
  seats                Int?
  /// Maximum seats allowed by the plan (if available).
  seatLimit            Int?         @map("seat_limit")
  /// Start of the billing period recorded at snapshot time.
  periodStart          DateTime     @map("period_start")
  /// End of the billing period recorded at snapshot time.
  periodEnd            DateTime     @map("period_end")
  /// Immutable creation timestamp.
  createdAt            DateTime     @default(now()) @map("created_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Lookup by org (general).
  @@index([orgId])
  /// Lookup by Stripe subscription ID for billing investigations.
  @@index([stripeSubscriptionId])
  /// Timeline query: "show subscription history for org X, newest first".
  @@index([orgId, createdAt(sort: Desc)])
  @@map("subscription_snapshots")
  @@schema("public")
}

// ============================================================================
// NOTIFICATION MODEL
// In-app notifications. Source of truth for realtime and unread-count badge.
// Scoped to a (user, org) pair for multi-tenant isolation.
// ============================================================================

model Notification {
  /// Internal UUID — primary key.
  id        String    @id @default(uuid()) @db.Uuid

  /// Organisation that owns this notification — tenant boundary.
  orgId     String    @map("org_id") @db.Uuid
  /// Recipient user.
  userId    String    @map("user_id") @db.Uuid

  /// Application-defined category (e.g. "invite", "billing", "alert").
  type      String
  /// Short notification title shown in the badge/list.
  title     String
  /// Full notification body text.
  body      String    @db.Text
  /// Optional structured metadata (action links, entity ids, …).
  metadata  Json?

  /// Timestamp when the user explicitly marked the notification as read.
  /// Null means unread.
  readAt    DateTime? @map("read_at")

  /// Immutable creation timestamp.
  createdAt DateTime  @default(now()) @map("created_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Tenant-level listing.
  @@index([orgId])
  /// User inbox listing.
  @@index([userId])
  /// Unread filter for a user.
  @@index([userId, readAt])
  /// Org activity feed ordered by date.
  @@index([orgId, createdAt])

  @@map("notifications")
  @@schema("public")
}

// ============================================================================
// FILE MODEL
// Metadata for files stored in external storage (S3, Azure Blob, etc.).
// The actual file bytes are NEVER stored in the database.
// Scoped to organization for multi-tenant isolation.
// ============================================================================

/// Lifecycle status of a file upload.
enum FileStatus {
  /// Upload session created, presigned URL generated, awaiting client upload.
  PENDING
  /// Client has confirmed upload completion; file is available.
  COMPLETED
  /// Upload session expired without confirmation.
  EXPIRED
  /// Upload was explicitly aborted by the user.
  ABORTED

  @@schema("public")
}

model File {
  /// Internal UUID – primary key.
  id          String     @id @default(uuid()) @db.Uuid
  /// FK → Organization. Cascade-delete removes files when the org is deleted.
  orgId       String     @map("org_id") @db.Uuid
  /// User who uploaded the file.
  uploadedBy  String     @map("uploaded_by") @db.Uuid
  /// Storage key (path in S3/Azure): org/{orgId}/{fileId}
  storageKey  String     @unique @map("storage_key")
  /// Storage provider: S3, AZURE, etc.
  provider    String
  /// Original filename provided by the client.
  filename    String
  /// File size in bytes (null until confirmed).
  size        BigInt?
  /// MIME type (e.g. application/pdf, image/png).
  mimeType    String?    @map("mime_type")
  /// Upload lifecycle status.
  status      FileStatus @default(PENDING)
  /// Presigned URL expiration timestamp.
  expiresAt   DateTime?  @map("expires_at")
  /// Timestamp when upload was confirmed.
  confirmedAt DateTime?  @map("confirmed_at")
  /// Immutable creation timestamp.
  createdAt   DateTime   @default(now()) @map("created_at")
  /// Timestamp of the last update.
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // ── Relations ──────────────────────────────────────────────────────────────
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────────
  /// Primary tenant query: "list all files for org X, newest first".
  @@index([orgId, createdAt(sort: Desc)])
  /// Status-filtered tenant query: "show all COMPLETED files for org X".
  @@index([orgId, status])
  /// User activity: "show all files uploaded by user Y".
  @@index([uploadedBy, createdAt(sort: Desc)])
  /// Cleanup job: find expired pending uploads.
  @@index([status, expiresAt])
  @@map("files")
  @@schema("public")
}
