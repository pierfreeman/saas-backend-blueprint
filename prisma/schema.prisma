// Main schema file — generator and datasource only.
// Models are split across sibling .prisma files in this directory.
// See: https://www.prisma.io/docs/orm/prisma-schema/overview/location#multi-file-prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../libs/prisma-business/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "app_audit"]
}
