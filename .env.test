# ─── Integration Test Environment ─────────────────────────────────────────────
# Used by: test/setup/load-env.ts (loaded via Jest setupFiles before each suite)
# Start infra: docker compose -f docker-compose.test.yml up -d
# Run migrations: npm run test:migrate
# Run tests: npm run test:integration

NODE_ENV=test
PORT=0

# ─── Business Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/saas_test

# ─── Legal Audit Database ──────────────────────────────────────────────────────
LEGAL_AUDIT_DATABASE_URL=postgresql://postgres:postgres@localhost:5441/legal_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Auth0 (mocked via nock — test RSA keypair, no real Auth0 tenant) ─────────
AUTH0_DOMAIN=test.auth0.local
AUTH0_AUDIENCE=https://api.test.local

# ─── Event Bus (local transport — no SQS required for API integration tests) ──
EVENT_BUS_TRANSPORT=local

# ─── SQS (for worker integration tests using LocalStack test instance) ─────────
SQS_STANDARD_QUEUE_URL=http://localhost:4567/000000000000/saas-backend-heavy-jobs
SQS_FIFO_QUEUE_URL=http://localhost:4567/000000000000/saas-backend-billing-events.fifo
AWS_ENDPOINT_URL=http://localhost:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
