# Test Environment Variables
NODE_ENV=test
PORT=3001

# Database - Using same PostgreSQL instance with separate test database
DATABASE_URL="postgresql://postgres:asdasd@localhost:5432/sports_intelligence_test?schema=public"

# Redis - Using same Redis instance as development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=kd9STXJxmHDywIyP

# Auth0 - Test configuration
AUTH0_DOMAIN=test.auth0.com
AUTH0_AUDIENCE=https://api.test.com

# Stripe - Test keys
STRIPE_SECRET_KEY=sk_test_mock_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_test_secret
STRIPE_PRICE_ID_PRO=price_test_pro
STRIPE_PRICE_ID_ENTERPRISE=price_test_enterprise

# Feature Flags
FEATURE_FLAGS_CACHE_TTL=10

# Admin
SUPER_ADMIN_EMAILS=admin@test.com,superadmin@test.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_BURST=20

# Security Middleware Layer
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_BLOCK_MS=900000
MAX_BODY_SIZE=2MB
SECURITY_HEADERS_ENABLED=true
CSRF_PROTECTION_ENABLED=true
SECURITY_AUTO_THROTTLE_ENABLED=true
SUSPICIOUS_SCORE_THRESHOLD=20

# CORS
CORS_ORIGIN=*
