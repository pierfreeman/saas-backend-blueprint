# ─── Integration Test Environment ─────────────────────────────────────────────
# Used by: test/setup/load-env.ts (loaded via Jest setupFiles before each suite)
# Start infra: docker compose -f docker-compose.test.yml up -d
# Run migrations: npm run test:migrate
# Run tests: npm run test:integration

NODE_ENV=test
PORT=0

# ─── Business Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/saas_test

# ─── Legal Audit Database ──────────────────────────────────────────────────────
LEGAL_AUDIT_DATABASE_URL=postgresql://postgres:postgres@localhost:5441/legal_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Auth0 (mocked via nock — test RSA keypair, no real Auth0 tenant) ─────────
AUTH0_DOMAIN=test.auth0.local
AUTH0_AUDIENCE=https://api.test.local

# ─── Event Bus (local transport — no SQS required for API integration tests) ──
EVENT_BUS_TRANSPORT=local

# ─── SQS (for worker integration tests using LocalStack test instance) ─────────
SQS_STANDARD_QUEUE_URL=http://localhost:4567/000000000000/saas-backend-heavy-jobs
SQS_FIFO_QUEUE_URL=http://localhost:4567/000000000000/saas-backend-billing-events.fifo
AWS_ENDPOINT_URL=http://localhost:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1


# ─── Stripe (test keys / mocked — no real Stripe calls in integration tests) ──
STRIPE_SECRET_KEY=sk_test_placeholder_for_integration_tests
STRIPE_WEBHOOK_SECRET=whsec_test_integration_secret_32chars_min
STRIPE_PRICE_ID_BASIC=price_test_basic
STRIPE_PRICE_ID_PRO=price_test_pro

# ─── Security ─────────────────────────────────────────────────────────────────
# Test-safe values: permissive limits so tests are never blocked by the security
# layer unless they specifically test rejection behaviour.

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

# Rate Limiting — very high limits to avoid interfering with test suites
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX_PER_IP=10000
RATE_LIMIT_MAX_PER_USER=10000
RATE_LIMIT_MAX_PER_TENANT=10000

# Brute-Force — minimal lockout so auth tests don't get stuck
BRUTE_FORCE_MAX_ATTEMPTS=100
BRUTE_FORCE_LOCKOUT_TTL=1
BRUTE_FORCE_TRACKING_TTL=60

# Request Body
MAX_BODY_SIZE=10mb

# Payload Sanitization
PAYLOAD_SANITIZATION_ENABLED=true

# CSRF — disabled; integration tests use Bearer tokens
CSRF_PROTECTION_ENABLED=false
CSRF_COOKIE_NAME=__csrf
CSRF_HEADER_NAME=x-csrf-token

# IP Filter — disabled
IP_ALLOWLIST_ENABLED=false
IP_ALLOWLIST=
IP_DENYLIST_ENABLED=false
IP_DENYLIST=

# WebSocket Rate Limiting — effectively unlimited in tests
WS_RATE_LIMIT_ENABLED=false
WS_RATE_LIMIT_MAX_MESSAGES_PER_MINUTE=10000
