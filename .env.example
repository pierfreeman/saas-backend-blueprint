# Application
NODE_ENV=development
PORT=3000
ADMIN_API_PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_backend"

# Legal Audit Database (separate instance, append-only, never cascade-deleted)
LEGAL_AUDIT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/saas_legal_audit"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.your-app.com
# M2M credentials — required only for email-based member invite flow.
# Create a Machine-to-Machine application in Auth0 with Management API access.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# SPA Application client ID — used to send passwordless email invites.
# Use the same Client ID as your frontend SPA application in Auth0.
AUTH0_SPA_CLIENT_ID=

# Auth0 Admin (separate SPA app + dedicated user DB connection)
# Auth0 Dashboard → Applications → SaaS Admin Portal (SPA)
# Auth0 Dashboard → APIs → SaaS Admin API (audience / resource server)
# Auth0 Dashboard → Authentication → Database → Admin-Users-DB (signup disabled)
ADMIN_AUTH0_DOMAIN=your-tenant.auth0.com
ADMIN_AUTH0_AUDIENCE=https://admin-api.your-api.com
# Namespace for custom claims set by the "Enrich Admin Access Token" Action.
# Must match the CLAIMS_NAMESPACE secret on that Auth0 Action (with trailing slash).
ADMIN_AUTH0_CLAIMS_NAMESPACE=https://admin.saas-api.com/
# M2M credentials for admin user management scripts (manage-admin-user.mjs,
# migrate-admin-users.mjs). NOT required at server runtime — leave empty in
# production server env. Use the "SaaS Admin CLI" M2M app (or the auto-created
# "SaaS Admin API (Test Application)") authorised on the Auth0 Management API
# with scopes: create:users read:users update:users create:user_tickets
ADMIN_AUTH0_M2M_CLIENT_ID=
ADMIN_AUTH0_M2M_CLIENT_SECRET=

# Frontend
# Base URL shown in invite emails. Defaults to http://localhost:4200.
FRONTEND_BASE_URL=http://localhost:4200

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# ============================================================================
# EMAIL MODULE
# ============================================================================
# Provider: 'resend' (default) or 'smtp'
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Your SaaS Platform

# Resend (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (required when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Feature Flags
FEATURE_FLAGS_CACHE_TTL=600

# Admin
SUPER_ADMIN_EMAILS=admin@example.com,superadmin@example.com

# ── Security ─────────────────────────────────────────────────────────────────

# CORS (comma-separated list of allowed origins; empty = block all in production)
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true

# Rate Limiting (Redis-backed, 3 axes: IP / user / tenant)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_USER=200
RATE_LIMIT_MAX_PER_TENANT=1000

# Brute-Force Protection (auth endpoints)
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_TTL=900
BRUTE_FORCE_TRACKING_TTL=3600

# Request Body Size Limit
MAX_BODY_SIZE=2mb

# Payload Sanitization (SQL/NoSQL/XSS pattern detection)
PAYLOAD_SANITIZATION_ENABLED=true

# CSRF (disabled by default — only needed for cookie-based auth flows)
# Auth0 Bearer token flows are inherently CSRF-safe; leave false unless using cookies.
CSRF_PROTECTION_ENABLED=false
CSRF_COOKIE_NAME=__csrf
CSRF_HEADER_NAME=x-csrf-token

# IP Filter (optional — disabled by default)
IP_ALLOWLIST_ENABLED=false
IP_ALLOWLIST=
IP_DENYLIST_ENABLED=false
IP_DENYLIST=

# WebSocket Rate Limiting
WS_RATE_LIMIT_ENABLED=true
WS_RATE_LIMIT_MAX_MESSAGES_PER_MINUTE=60

# Observability / Logging
APP_ENV=local
LOG_PROVIDER=nest
LOG_LEVEL=debug

# Sentry (optional - for staging/production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Datadog (optional - for staging/production)
DATADOG_API_KEY=
DATADOG_SERVICE=sports-intelligence-backend
DATADOG_ENV=
DATADOG_VERSION=
DATADOG_SITE=datadoghq.com

# ============================================================================
# STORAGE MODULE ENVIRONMENT VARIABLES
# ============================================================================

# Default Storage Provider (S3 | AZURE)
DEFAULT_STORAGE_PROVIDER=S3

# ============================================================================
# AWS S3 Configuration
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=sports-intelligence-storage

# Optional: For S3-compatible services (MinIO, DigitalOcean Spaces, etc.)
# AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# ============================================================================
# SQS / Event Bus
# ============================================================================
# Transport: "local" (in-memory, default in dev/test) | "sqs" (production / docker)
EVENT_BUS_TRANSPORT=local

# Set automatically by docker-compose (LocalStack). Override for real AWS:
# Local dev (LocalStack):
SQS_ENDPOINT_URL=http://localhost:4566
SQS_STANDARD_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/saas-backend-heavy-jobs
# Production (real AWS — override these in your deployment environment):
# SQS_ENDPOINT_URL=
# SQS_STANDARD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/saas-backend-heavy-jobs
SQS_FIFO_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/saas-backend-billing-events.fifo

# ============================================================================
# Azure Blob Storage Configuration
# ============================================================================
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_STORAGE_KEY=your-storage-account-key
AZURE_STORAGE_CONTAINER=sports-intelligence-storage

# Optional: Custom endpoint
# AZURE_STORAGE_ENDPOINT=https://youraccount.blob.core.windows.net

# ============================================================================
# Storage Quota Configuration (Optional Overrides)
# ============================================================================
# These values override the default plan-based limits

# FREE_PLAN_STORAGE_LIMIT_GB=1
# PRO_PLAN_STORAGE_LIMIT_GB=50
# ENTERPRISE_PLAN_STORAGE_LIMIT_GB=  # Leave empty for unlimited

# FREE_PLAN_FILE_COUNT_LIMIT=100
# PRO_PLAN_FILE_COUNT_LIMIT=10000
# ENTERPRISE_PLAN_FILE_COUNT_LIMIT=  # Leave empty for unlimited

# FREE_PLAN_MAX_FILE_SIZE_GB=0.1  # 100MB
# PRO_PLAN_MAX_FILE_SIZE_GB=20    # 20GB
# ENTERPRISE_PLAN_MAX_FILE_SIZE_GB=100  # 100GB

# ============================================================================
# Upload Session Configuration
# ============================================================================
# Hours before upload session expires
UPLOAD_SESSION_EXPIRATION_HOURS=24

# Days to keep completed/aborted sessions before deletion
UPLOAD_SESSION_RETENTION_DAYS=7

# Presigned URL expiration (seconds)
PRESIGNED_URL_EXPIRATION_SECONDS=3600  # 1 hour

# ============================================================================
# Cleanup Jobs Configuration
# ============================================================================
# Enable/disable automatic cleanup jobs
STORAGE_CLEANUP_ENABLED=true

# Cron schedule for marking expired sessions (default: every hour)
# STORAGE_CLEANUP_EXPIRED_SESSIONS_CRON=0 * * * *

# Cron schedule for deleting old sessions (default: daily at 2 AM)
# STORAGE_CLEANUP_OLD_SESSIONS_CRON=0 2 * * *

# Cron schedule for aborting expired uploads (default: every 6 hours)
# STORAGE_CLEANUP_EXPIRED_UPLOADS_CRON=0 */6 * * *

# ============================================================================
# Organization Deletion Configuration
# ============================================================================
# Default retention period in days before scheduled deletion executes (GDPR compliance)
ORG_DELETION_RETENTION_DAYS=30

# Cron schedule for checking organizations eligible for deletion (default: daily at 3 AM)
# ORG_DELETION_CHECK_CRON=0 3 * * *

