{
  "name": "jobs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/jobs/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:jobs"],
  "// targets": "to see all targets run: nx show project jobs --web",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/jobs"],
      "options": {
        "jestConfig": "libs/jobs/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/jobs/tsconfig.json --noEmit"
      }
    }
  }
}
