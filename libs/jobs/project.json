{
  "name": "jobs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/jobs/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:jobs"
  ],
  "// targets": "to see all targets run: nx show project jobs --web",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/libs/jobs"
      ],
      "options": {
        "configFile": "libs/jobs/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/jobs/tsconfig.json --noEmit"
      }
    }
  }
}