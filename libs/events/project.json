{
  "name": "events",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/events/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:events"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/events",
        "tsConfig": "libs/events/tsconfig.lib.json",
        "packageJson": "libs/events/package.json",
        "main": "libs/events/src/index.ts",
        "assets": [
          "libs/events/*.md"
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/libs/events"
      ],
      "options": {
        "configFile": "libs/events/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/events/tsconfig.lib.json --noEmit"
      }
    }
  }
}