{
  "name": "admin-auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/admin/auth/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:admin"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/unit/libs/admin/auth"],
      "options": {
        "configFile": "libs/admin/auth/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/admin/auth/tsconfig.json --noEmit"
      }
    }
  }
}
