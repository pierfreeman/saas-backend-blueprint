{
  "name": "notifications",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/notifications/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:notifications"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/unit/libs/notifications"],
      "options": {
        "jestConfig": "libs/notifications/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/notifications/tsconfig.lib.json --noEmit"
      }
    }
  }
}
