{
  "name": "billing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/billing/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:billing"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/unit/libs/billing"],
      "options": {
        "jestConfig": "libs/billing/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/billing/tsconfig.lib.json --noEmit"
      }
    }
  }
}
