{
  "name": "activity-log",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/activity-log/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:activity-log"
  ],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/libs/activity-log"
      ],
      "options": {
        "configFile": "libs/activity-log/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/activity-log/tsconfig.json --noEmit"
      }
    }
  }
}