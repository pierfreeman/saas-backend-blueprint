{
  "name": "audit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audit/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
