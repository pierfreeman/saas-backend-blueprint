        "jestConfig": "libs/audit/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/audit/tsconfig.json --noEmit"
      }
    }
  },
  "tags": ["type:lib", "scope:audit"]
}
