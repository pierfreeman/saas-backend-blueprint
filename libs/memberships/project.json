{
  "name": "memberships",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/memberships/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:memberships"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/memberships"],
      "options": {
        "jestConfig": "libs/memberships/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/memberships/tsconfig.json --noEmit"
      }
    }
  }
}
