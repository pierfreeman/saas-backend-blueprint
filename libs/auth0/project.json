{
  "name": "auth0",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth0/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:auth"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/auth0/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/unit/libs/auth0"],
      "options": {
        "configFile": "libs/auth0/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "test-integration": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/integration/libs/auth0"],
      "options": {
        "configFile": "libs/auth0/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/auth0/**/*.ts"]
      }
    }
  }
}
