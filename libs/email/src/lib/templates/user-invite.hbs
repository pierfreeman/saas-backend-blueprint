<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>You've Been Invited</title>
</head>
<body style="font-family: Arial, sans-serif; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  {{#if recipientName}}
  <p>Hello {{recipientName}},</p>
  {{else}}
  <p>Hello,</p>
  {{/if}}

  <p>
    <strong>{{inviterName}}</strong> has invited you to join
    <strong>{{orgName}}</strong> on our platform.
  </p>

  <p style="text-align: center; margin: 30px 0;">
    <a href="{{inviteUrl}}"
       style="background-color: #4F46E5; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;">
      Accept Invitation
    </a>
  </p>

  {{#if expiresInDays}}
  <p style="color: #666; font-size: 14px;">This invitation expires in {{expiresInDays}} days.</p>
  {{/if}}

  <p style="color: #666; font-size: 12px; margin-top: 40px;">
    If you were not expecting this invitation, you can safely ignore this email.
  </p>
</body>
</html>
