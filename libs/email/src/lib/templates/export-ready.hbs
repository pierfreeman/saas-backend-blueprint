<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Your Export Is Ready</title>
</head>
<body style="font-family: Arial, sans-serif; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  {{#if recipientName}}
  <p>Hello {{recipientName}},</p>
  {{else}}
  <p>Hello,</p>
  {{/if}}

  <p>Your export <strong>{{exportName}}</strong> is ready for download.</p>

  <p style="text-align: center; margin: 30px 0;">
    <a href="{{downloadUrl}}"
       style="background-color: #4F46E5; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;">
      Download Export
    </a>
  </p>

  {{#if expiresInHours}}
  <p style="color: #666; font-size: 14px;">The download link expires in {{expiresInHours}} hours.</p>
  {{/if}}

  <p style="color: #666; font-size: 12px; margin-top: 40px;">
    If you did not request this export, please contact our support team.
  </p>
</body>
</html>
