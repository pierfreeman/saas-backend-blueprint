{
  "name": "common",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/common",
        "main": "libs/common/src/index.ts",
        "tsConfig": "libs/common/tsconfig.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/libs/common"
      ],
      "options": {
        "configFile": "libs/common/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/common/tsconfig.json --noEmit"
      }
    }
  },
  "tags": [
    "type:lib",
    "scope:common"
  ]
}