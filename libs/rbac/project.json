{
  "name": "rbac",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rbac/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:rbac"
  ],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": []
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/libs/rbac"
      ],
      "options": {
        "configFile": "libs/rbac/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/rbac/tsconfig.json --noEmit"
      }
    }
  }
}