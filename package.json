{
  "name": "@saas-backend/source",
  "version": "0.8.0",
  "description": "Source code for the SaaS backend application",
  "author": "Piercarlo Serena <piercarlo.serena@gmail.com>",
  "repository": "https://github.com/pierfreeman/saas-backend-blueprint",
  "bugs": "https://github.com/pierfreeman/saas-backend-blueprint/issues",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t serve --projects=api,admin-api,worker-a --parallel=3 --output-style=stream",
    "dev:kill": "lsof -ti :3000 -ti :3001 -ti :9229 -ti :9230 -ti :9231 | xargs --no-run-if-empty kill -9 2>/dev/null || true",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:migrate": "prisma migrate dev && prisma migrate dev --config prisma.config.legal.ts",
    "build:api": "nx build api",
    "build:admin-api": "nx build admin-api",
    "build:worker-a": "nx build worker-a",
    "build:all": "nx run-many -t build --projects=api,admin-api,worker-a --parallel=1",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "graph": "nx graph",
    "test:unit": "nx run-many --target=test --all --exclude='tag:type:e2e' --parallel=3",
    "test:unit:coverage": "nx run-many --target=test --all --exclude='tag:type:e2e' --coverage --parallel=3",
    "test:unit:watch": "nx test api --watch",
    "test:affected": "nx affected -t test --exclude='tag:type:e2e'",
    "test:integration": "nx run-many --target=e2e --projects=api-e2e,admin-api-e2e,worker-a-e2e --parallel=1 && nx run email:test-integration",
    "test:integration:api": "nx e2e api-e2e",
    "test:integration:admin-api": "nx e2e admin-api-e2e",
    "test:integration:worker": "nx e2e worker-a-e2e",
    "test:integration:coverage": "nx run-many --target=e2e --projects=api-e2e,admin-api-e2e,worker-a-e2e --parallel=1 --coverage",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "test:migrate": "node scripts/migrate-test.cjs",
    "prisma:generate": "prisma generate && prisma generate --config prisma.config.legal.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:dev:legal": "prisma migrate dev --config prisma.config.legal.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:legal": "prisma migrate deploy --config prisma.config.legal.ts",
    "prisma:studio": "prisma studio",
    "prisma:studio:legal": "prisma studio --config prisma.config.legal.ts",
    "postinstall": "prisma generate && prisma generate --config prisma.config.legal.ts",
    "admin:promote": "node scripts/promote-admin.mjs",
    "coverage:serve": "python3 -m http.server 4321 --directory coverage",
    "docker:build:api": "docker build --build-arg APP_NAME=api -t saas-api:latest .",
    "docker:build:admin-api": "docker build --build-arg APP_NAME=admin-api -t saas-admin-api:latest .",
    "docker:build:worker-a": "docker build --build-arg APP_NAME=worker-a -t saas-worker-a:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/client-sqs": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@sentry/node": "^10.47.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "0.15.1",
    "eventemitter2": "^6.4.9",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "jszip": "^3.10.1",
    "jwks-rsa": "^4.0.1",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "stripe": "^21.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.17",
    "@nx/docker": "22.6.4",
    "@nx/eslint": "22.6.4",
    "@nx/eslint-plugin": "22.6.4",
    "@nx/js": "22.6.4",
    "@nx/nest": "22.6.4",
    "@nx/node": "22.6.4",
    "@nx/vite": "^22.6.4",
    "@nx/web": "22.6.4",
    "@nx/webpack": "22.6.4",
    "@nx/workspace": "22.6.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.21",
    "@swc/helpers": "~0.5.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.1",
    "@types/node": "25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "eslint": "10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "jsonc-eslint-parser": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "nock": "^14.0.11",
    "nx": "22.6.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "~3.8.1",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2",
    "webpack-cli": "^7.0.2"
  }
}
