{
  "name": "@nx-nest/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many --target=build --projects=api,worker-compute-a,worker-compute-b --parallel=1",
    "build:all": "nx run-many --target=build --all --parallel=1",
    "build:api": "nx build api",
    "build:worker-a": "nx build worker-compute-a",
    "build:worker-b": "nx build worker-compute-b",
    "start:api": "nx serve api",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker-a": "node dist/apps/worker-compute-a/main.js",
    "start:worker-b": "node dist/apps/worker-compute-b/main.js",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "test:unit": "nx run-many --target=test --projects=api,worker-a,common,audit --parallel=3",
    "test:coverage": "nx run-many --target=test --projects=api,worker-a,common,audit --coverage --parallel=3",
    "test:watch": "nx test api --watch",
    "test:affected": "nx affected -t test",
    "typecheck": "nx run-many --target=typecheck --all",
    "graph": "nx graph",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "docker:build": "docker build -t nx-nest:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.14",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.2.0",
    "axios": "^1.13.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.9.3",
    "joi": "^18.0.2",
    "jwks-rsa": "^3.2.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.14",
    "@nx/docker": "22.5.2",
    "@nx/eslint": "22.5.2",
    "@nx/eslint-plugin": "22.5.2",
    "@nx/jest": "22.5.2",
    "@nx/js": "22.5.2",
    "@nx/nest": "22.5.2",
    "@nx/node": "22.5.2",
    "@nx/web": "22.5.2",
    "@nx/webpack": "22.5.2",
    "@nx/workspace": "22.5.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.13",
    "@swc/helpers": "~0.5.19",
    "@types/jest": "^30.0.0",
    "@types/node": "25.3.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jest-util": "^30.2.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.5.2",
    "prettier": "~3.8.1",
    "prisma": "^6.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack-cli": "^6.0.1"
  }
}
